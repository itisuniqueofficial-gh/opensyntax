{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/cli.ts",
    "src/index.ts",
    "src/agent/**/*.ts",
    "src/auth/**/*.ts",
    "src/commands/**/*.ts",
    "src/doctor/**/*.ts",
    "src/providers/**/*.ts",
    "src/tools/**/*.ts",
    "src/model/**/*.ts",
    "src/ui/chat.ts",
    "src/ui/renderer.ts",
    "src/ui/prompts.ts",
    "src/ui/markdown.ts",
    "src/session/**/*.ts",
    "src/config/config.ts",
    "src/config/defaults.ts",
    "src/utils/logger.ts",
    "src/utils/paths.ts",
    "src/utils/errors.ts",
    "src/utils/streams.ts",
    "src/utils/schema.ts",
    "src/tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
