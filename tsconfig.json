{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "../ui-config.js": ["src/ui/ui-config.ts"]
    }
  },
  "include": [
    "src/cli.ts",
    "src/index.ts",
    "src/agent/**/*.ts",
    "src/auth/**/*.ts",
    "src/commands/**/*.ts",
    "src/doctor/**/*.ts",
    "src/providers/**/*.ts",
    "src/rules/**/*.ts",
    "src/tools/**/*.ts",
    "src/model/**/*.ts",
    "src/ui/**/*.ts",
    "src/session/**/*.ts",
    "src/config/**/*.ts",
    "src/utils/**/*.ts",
    "src/tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
