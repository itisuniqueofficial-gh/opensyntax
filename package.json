{
  "name": "opensyntax",
  "version": "0.6.0",
  "description": "Terminal-first AI coding agent with workspace tools, safe edits, git awareness, sessions, and multi-provider LLM support.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itisuniqueofficial-gh/opensyntax.git"
  },
  "bugs": {
    "url": "https://github.com/itisuniqueofficial-gh/opensyntax/issues"
  },
  "homepage": "https://os.itisuniqueofficial.com/",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "terminal",
    "cli",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "openrouter",
    "typescript",
    "developer-tools",
    "code-assistant",
    "automation",
    "git"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opensyntax": "dist/cli.js",
    "agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "docs:validate": "node scripts/validate-docs.mjs",
    "release": "semantic-release",
    "clean": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "ignore": "^6.0.2",
    "marked": "^15.0.12",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.5.4",
    "@types/prompts": "^2.4.9",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "semantic-release": "^24.2.9",
    "tsup": "^8.2.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
